# joekendall.co.uk on LiteSpeed / Apache
#
# Other sites share this docroot, so every rule below is limited to the
# joekendall.co.uk host.

# index.php stays in the list for the other sites that inherit this file
DirectoryIndex index.html index.htm index.php
ErrorDocument 404 /404.html
SetEnvIfNoCase Host "^(www\.)?joekendall\.co\.uk$" JK_SITE

<IfModule mod_rewrite.c>
RewriteEngine On

# Every rule below is limited to joekendall.co.uk and www, and each one sends
# the visitor to https://joekendall.co.uk/ in a single hop.

# Old site (2010 and the 2013 Jekyll site). See README.md.
RewriteCond %{HTTP_HOST} ^(www\.)?joekendall\.co\.uk$ [NC]
RewriteRule ^dev(/.*)?$ https://joekendall.co.uk/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?joekendall\.co\.uk$ [NC]
RewriteRule ^(css/stylesheet\.css|js/meny\.min\.js)$ - [G,L]

# /index.html and /writing/index.html go to the folder, so each page has one URL
RewriteCond %{HTTP_HOST} ^(www\.)?joekendall\.co\.uk$ [NC]
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ https://joekendall.co.uk/%1 [R=301,L,NE]

# http, and www on either scheme, go to https://joekendall.co.uk/
RewriteCond %{HTTP_HOST} ^(www\.)?joekendall\.co\.uk$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://joekendall.co.uk%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Types the server may not know
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType application/rss+xml .rss
AddCharset utf-8 .html .css .txt .xml .svg
<Files "feed.xml">
  ForceType application/rss+xml
</Files>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff" env=JK_SITE
  Header always set Referrer-Policy "strict-origin-when-cross-origin" env=JK_SITE
  Header always set X-Frame-Options "SAMEORIGIN" env=JK_SITE

  # Browsers stay on https for a year. Not includeSubDomains: other subdomains share this domain.
  Header always set Strict-Transport-Security "max-age=31536000" env=JK_SITE
  # The server adds its own one-week Expires; Cache-Control below is the one that counts
  Header unset Expires env=JK_SITE

  # Pages, sitemap, feed and text files: cached for five minutes, then checked again
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300" env=JK_SITE
  </FilesMatch>
  # CSS and fonts are linked with ?v=<hash>, so they never change in place
  <FilesMatch "\.(css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=JK_SITE
  </FilesMatch>
  # Photos and icons keep their names, so cache for a month
  <FilesMatch "\.(avif|webp|jpe?g|png|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000" env=JK_SITE
  </FilesMatch>
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# This domain inherits the “PHP” package.
# php -- END cPanel-generated handler, do not edit
